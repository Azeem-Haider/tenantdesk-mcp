# Copy to .env and adjust. Every variable is validated at startup (src/config.ts).
NODE_ENV=development
PORT=3333
PUBLIC_URL=http://localhost:3333
LOG_LEVEL=info

# Leave empty to use in-memory PGlite (demo). Set for real Postgres.
DATABASE_URL=postgres://tenantdesk:tenantdesk@localhost:5432/tenantdesk
DATABASE_POOL_MAX=10
SEED_DEMO=true

# dev = local HS256 tokens (blocked in production). oidc = tokens from your identity provider.
AUTH_MODE=dev
TENANTDESK_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# OIDC_ISSUER=https://your-tenant.us.auth0.com/
# OIDC_AUDIENCE=https://mcp.example.com/mcp
# OIDC_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json

STRIPE_WEBHOOK_SECRET=whsec_dev_only
# STRIPE_SECRET_KEY=sk_test_...   # without it, refunds use the in-memory fake provider

RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=1000000

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=tenantdesk-mcp
